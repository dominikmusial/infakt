# Klucz API z inFaktu (pobrany z https://konto.sandbox-infakt.pl/ w Ustawienia -> Inne -> API)
INFAKT_API_KEY=twoj_klucz_api_tutaj

# Środowisko: "sandbox" (domyślne) lub "production"
# sandbox: https://api.sandbox-infakt.pl/api/v3
# production: https://api.infakt.pl/api/v3
INFAKT_ENVIRONMENT=sandbox
